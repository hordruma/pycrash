# Crashout Environment Configuration
# Copy this file to .env and fill in your values

# LLM API Keys (at least one needed for AI extraction)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis (default for Docker setup)
REDIS_URL=redis://redis:6379/0

# FalkorDB (default for Docker setup)
FALKORDB_URL=redis://falkordb:6379/0

# Environment
PYCRASH_ENV=development
